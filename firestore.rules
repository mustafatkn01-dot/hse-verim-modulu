rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sahip: kendi verisinin tamamı
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ---- Misafir erişimi (Anonim giriş + sahip onayı) ----
    // Davet: yalnızca tek tek okunabilir (listelenemez)
    match /users/{owner}/invites/{code} {
      allow get: if request.auth != null;
    }

    // Onay isteği: misafir kendi isteğini oluşturur/okur; durumu yalnızca "pending"e çekebilir
    match /users/{owner}/guestReqs/{gid} {
      allow get: if request.auth != null && request.auth.uid == gid;
      allow create, update: if request.auth != null && request.auth.uid == gid
        && request.resource.data.keys().hasOnly(['gid', 'code', 'name', 'unit', 'email', 'status', 'at'])
        && request.resource.data.gid == gid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() < 80
        && request.resource.data.unit is string && request.resource.data.unit.size() < 80
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() < 120))
        && exists(/databases/$(database)/documents/users/$(owner)/invites/$(request.resource.data.code));
    }

    // Geri bildirim: misafir yalnızca kendi uid'si ile başlayan kimlikle yeni mesaj bırakır (sahip okur / siler)
    match /users/{owner}/feedback/{id} {
      allow create: if request.auth != null
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['gid', 'name', 'text', 'at', 'read'])
        && request.resource.data.gid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.name is string && request.resource.data.name.size() < 80
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && exists(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.expires == null
            || get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.expires > request.time);
    }

    // Onaylı üye kaydı: misafir yalnızca kendi kaydını okur
    match /users/{owner}/members/{gid} {
      allow get: if request.auth != null && request.auth.uid == gid;
    }

    // Denetim gelen kutusu: misafir yalnızca kendi satırını (id'si kendi uid'si ile başlar), yetkili olduğu fabrika için yazar
    match /users/{owner}/inbox/{id} {
      allow create, update: if request.auth != null
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['fid', 'year', 'month', 'dept', 'deptName', 'factoryName', 'no', 'by', 'byName', 'kind', 'status', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.kind in ['saved', 'review']
        && exists(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.expires == null
            || get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.expires > request.time)
        && request.resource.data.fid in get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.factories;
    }

    // Fabrika bazlı okuma / veri girişi (süresi dolmamış ve o fabrikaya yetkili üye)
    match /users/{owner}/factories/{fid} {
      function live() {
        return request.auth != null
          && exists(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid))
          && (get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.expires == null
              || get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.expires > request.time)
          && fid in get(/databases/$(database)/documents/users/$(owner)/members/$(request.auth.uid)).data.factories;
      }

      allow get: if live();

      match /years/{y} {
        allow read: if live();

        match /setup/{s} {
          allow read: if live();
        }

        // Aylık veri koleksiyonları (silme yok).
        // İSG denetim kayıtlarını (isg) misafir yalnızca okur; kendi taslağını (isgg, id'si kendi uid'si ile biter) yazar.
        match /{coll}/{docId} {
          allow read: if live() && (coll in ['isg', 'kaza', 'konusma', 'isbasi', 'konusmag', 'isbasig', 'kazag', 'ramak', 'foto']
            || (coll == 'isgg' && (docId.matches('.*_' + request.auth.uid) || docId.matches('.*_fix_.*'))));
          // Eğitim konuşması / işbaşı eğitim / iş kazası aylık kaydını misafir DEĞİŞTİREMEZ; yalnızca kendi "bekleyen" kaydını ekler (sahip onaylar) veya bekleyen kaydını siler
          allow create: if live() && coll in ['konusmag', 'isbasig', 'kazag']
            && docId.matches('.*_' + request.auth.uid + '_.*')
            && request.resource.data.keys().hasOnly(['guestUid', 'guestName', 'dept', 'month', 'd', 'min', 'g', 'e', 't', 'note', 'status', 'at', 'updatedAt'])
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.guestName is string && request.resource.data.guestName.size() < 80;
          allow delete: if live() && coll in ['konusmag', 'isbasig', 'kazag']
            && resource.data.guestUid == request.auth.uid && resource.data.status == 'pending';
          // Ramak kala bildirimi: misafir yalnızca kendi "bekleyen" kaydını ekler (sahip onaylar/reddeder) veya bekleyen kaydını siler
          allow create: if live() && coll == 'ramak'
            && docId.matches('.*_' + request.auth.uid + '_.*')
            && request.resource.data.keys().hasOnly(['guestUid', 'guestName', 'month', 'd', 'src', 'dept', 'who', 'place', 'txt', 'tip', 'photos', 'status', 'at', 'updatedAt'])
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.src in ['b', 's']
            && request.resource.data.guestName is string && request.resource.data.guestName.size() < 80
            && request.resource.data.txt is string && request.resource.data.txt.size() > 0 && request.resource.data.txt.size() <= 1000;
          allow delete: if live() && coll == 'ramak'
            && resource.data.guestUid == request.auth.uid && resource.data.status == 'pending';
          allow create, update: if live() && (
            coll in ['foto']
            || (coll == 'isgg' && docId.matches('.*_' + request.auth.uid)
                && request.resource.data.keys().hasOnly(['guestUid', 'guestName', 'dept', 'month', 'status', 'draft', 'at', 'updatedAt', 'note'])
                && request.resource.data.guestUid == request.auth.uid
                && request.resource.data.status in ['draft', 'saved', 'review', 'returned']));
        }
      }
    }

    // Bulgu paylaşımı: yalnızca sahip yazar; misafir yalnızca kendisinin listede olduğu paylaşımları okur
    match /users/{owner}/shares/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.guests;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
